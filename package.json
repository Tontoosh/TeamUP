{
  "name": "teamup",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build && node scripts/check-lines.js",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "playwright test",
    "check:lines": "node scripts/check-lines.js",
    "db:check": "node scripts/check-db.js",
    "db:test-users": "node scripts/create-test-users.js",
    "test:integration": "node --test tests/auth-integration.test.js",
    "start:lab10": "node scripts/start-lab10.js",
    "test:performance": "node scripts/check-search-performance.js",
    "sql:export": "node scripts/export-sql.js",
    "db:inspect": "node scripts/inspect-db.js",
    "db:verify": "node scripts/verify-db-api.js"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.548.0",
    "pino": "^10.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "vite": "^7.1.11",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^6.2.2",
    "mssql": "^12.0.0",
    "nodemailer": "^10.5.0"
  }
}
