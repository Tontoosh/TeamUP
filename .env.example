PORT=3001
APP_URL=http://localhost:5173
DB_DRIVER=sqlite
SQLITE_PATH=./data/teamup.db
# DB_DRIVER=mssql
# SQL_SERVER=localhost
# SQL_PORT=1433
# SQL_DATABASE=teamup
# SQL_USER=sa
# SQL_PASSWORD=change-me
# SQL_TRUST_CERTIFICATE=true
# Seed fictional demo accounts on a fresh database; disable on a real deployment.
SEED_DEMO=true
# Temporary local preview: skip login and choose a seeded demo identity.
# Set false to restore login. Ignored in production or with SQL Server.
AUTH_BYPASS=false
COOKIE_SECURE=false
UPLOAD_MAX_MB=10
UPLOAD_TYPES=.pdf,.png,.jpg,.jpeg,.webp,.txt,.csv,.zip,.docx,.pptx
# Configure SMTP for verification and reset emails. Local mode logs links to the server.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=TeamUp <noreply@example.com>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Windows Authentication (uses the Windows account running Node)
# SQL_AUTH=windows
# SQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# SQL_ENCRYPT=true
